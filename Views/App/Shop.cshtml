@model IEnumerable<Product> 


<img src="~/img/blue.jpg" id="bgimg" />
<h1>Shop</h1>
<p>Count: @Model.Count()</p>
<div class="row">
    @foreach (var p in Model)
    {
        <div class="col-md-3">
            <div class="border bg-dark rounded p-1">
                <img src="~/img/@(p.PhotoId).jpg" class="img-fluid" alt="@p.Title" />
                <h3>@p.Category</h3>
                <ul>
                    <li>Price: $@p.Price</li>
                    <li>Title: @p.Title</li>
                    <li>Description: @p.Description</li>
                </ul>
                <button id="buyButton" class="btn btn-success">Buy</button>
            </div>
        </div>
    }
</div>